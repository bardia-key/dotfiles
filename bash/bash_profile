#!/usr/bin/env sh

. ${HOME}/.bashrc

source ${HOME}/.alias

if [ -d "$HOME/etc/bash_completion.d" ]; then
	. $HOME/etc/bash_completion.d/*.bash
fi

if [ -f /etc/bash_completion ]; then
	. /etc/bash_completion
fi

if [ -f "$HOME/.ep_bashrc" ]; then
	. $HOME/.ep_bashrc
fi

if [ -f "$HOME/.pifive_bashrc" ]; then
	. $HOME/.pifive_bashrc
fi
