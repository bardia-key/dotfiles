{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    }
  },
  "permission": {
    "edit": "ask",
    "bash": {
        "git *": "allow",
        "ls *": "allow",
        "echo *": "allow",
        "grep *": "allow",
        "find *": "allow",
        "sort *": "allow",
        "head *": "allow",
        "tail *": "allow",
        "cd *": "allow",
        "make *": "allow",
        "cat *": "allow",
        "sed *": "allow",
        "xargs *": "allow",
        "rg *": "allow",
        "rm *": "deny"
    }
  }
}
